# =========================================================================
# JARVIS-APEX ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your secrets.
# DO NOT COMMIT YOUR REAL .ENV FILE TO VERSION CONTROL.
# =========================================================================

# Server and Network
PORT=8000
HOST=127.0.0.1
SESSION_TOKEN=jarvis_secure_session_token_replace_with_random_string
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Hardware Privacy Defaults (Safety Enforcement)
ENABLE_WAKE_WORD_DEFAULT=False
ENABLE_SCREEN_VISION=False

# -------------------------------------------------------------------------
# AI PROVIDERS & API KEYS
# -------------------------------------------------------------------------
# Google Gemini 3-Key Pool (Round-robin failover)
GEMINI_API_KEY=your_gemini_api_key_primary
GEMINI_API_KEY_1=your_gemini_api_key_secondary
GEMINI_API_KEY_2=your_gemini_api_key_tertiary

# Groq LPU (Ultra-fast inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter (Multi-model provider)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Sarvam AI (Indic Hindi voice and language models)
SARVAM_API_KEY=your_sarvam_api_key_here

# Local Offline Ollama LLM (Private sovereign intelligence)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS
# -------------------------------------------------------------------------
SERPER_API_KEY=your_serper_api_key_for_live_search
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
MORNING_BRIEFING_TIME=09:00
USER_LOCATION=Dullahpur, Uttar Pradesh
