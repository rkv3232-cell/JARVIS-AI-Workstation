HOST=127.0.0.1
PORT=8000
DEBUG=True
JARVIS_LANG=hi
JARVIS_VOICE=hi-IN-MadhurNeural

# AI Model Provider Keys
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Gemini Multi-Key Pool (Auto-Rotating & 3.8 Probe)
GEMINI_API_KEY=your_gemini_api_key_0
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2

# Specialized Task-Specific Free AI Models (100% Free Tiers)
MODEL_CHAT=qwen/qwen3.8-27b
MODEL_CODING=openai/gpt-oss-120b
MODEL_REASONING=openai/gpt-oss-120b
MODEL_VISION=gemini-3.5-flash-lite
MODEL_FACT_CHECK=openai/gpt-oss-120b
MODEL_RESEARCH_WRITER=gemini-3.5-flash-lite
MODEL_RESEARCH_VOICE=qwen/qwen3.8-27b
MODEL_STT=whisper-large-v3-turbo

# Market Scanner
DEFAULT_SYMBOLS=NIFTY50,BANKNIFTY,BTCUSDT,ETHUSDT,SOLUSDT
SCANNER_INTERVAL_SECONDS=30
MIN_RISK_REWARD=2.0

# Sarvam AI (Indian Voice TTS & Indic LLM)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3
SARVAM_PACE=1.06

FIREBASE_PROJECT_ID=your_firebase_project_id
ENABLE_SCREEN_VISION=True
MORNING_BRIEFING_TIME=09:00
USER_LOCATION=Dullahpur, Uttar Pradesh
